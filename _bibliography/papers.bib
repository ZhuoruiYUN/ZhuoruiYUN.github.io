@article{chen2026dynamics,
  title={Dynamics-Informed Reinforcement Learning for Agile and Energy-Efficient Locomotion of a Monopedal Hopping Quadcopter},
  author={Chen, Ruigang and Zhang, Qi and Zhong, Zhicheng and Yun, Zhuorui and Or, Yizhar and Liu, Mingyi},
  journal={arXiv preprint arXiv:2609.15399},
  year={2026},
  selected={true},
  arxiv={2609.15399},
  abstract={A simulation-focused study of dynamics-informed reinforcement learning for agile, energy-efficient monopedal hopping. The method stabilizes a target specific-energy manifold, rewards phase-consistent stance restitution, and penalizes electromechanical power waste to prevent hovering-based reward hacking. In MuJoCo, the policy sustains height regulation and forward-speed tracking up to 2.0 m/s while reducing energy consumption by 82\% relative to a hovering baseline and 73\% relative to an inefficient RL baseline.},
  preview={crazyflie.svg},
  website={/publications/dynamics-informed-rl/}
}

@article{chen2026passive,
  title={Learning to Exploit Passive Dynamics for Energy-Efficient Target Hopping of a Spring-Legged Quadcopter},
  author={Chen, Ruigang and Zhang, Qi and Zhong, Zhicheng and Yun, Zhuorui and Or, Yizhar and Liu, Mingyi},
  journal={arXiv preprint arXiv:2609.15447},
  year={2026},
  selected={true},
  arxiv={2609.15447},
  note={Under review at IEEE Robotics and Automation Letters (RA-L)},
  abstract={A sim-to-real study of direct estimated-state-to-motor PPO control for a spring-legged quadcopter. The policy uses a 37-dimensional observation, energy-manifold and efficiency shaping, and a history-aware electrical-power estimator; it is trained in Isaac Lab and deployed through an ONNX stack with Vicon and IMU state estimation. In representative hardware runs, it reduced cycle-averaged measured electrical power by 30.7\% and normalized thrust by 49.8\% relative to a tuned PID control stack, while retaining repeatable height hopping and more concentrated landings.},
  preview={crazyflie.svg},
  website={/publications/passive-dynamics/}
}
