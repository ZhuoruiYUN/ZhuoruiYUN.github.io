<article class="experience-project card">
  <div class="row align-items-start">
    <div class="col-sm-4 experience-project-media">
      {% if project.img %}
        <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" aria-label="{{ project.title }}">
          {%
            include figure.liquid
            loading="lazy"
            path=project.img
            sizes="(min-width: 992px) 230px, (min-width: 768px) 33vw, 100vw"
            alt=project.title
          %}
        </a>
      {% endif %}
    </div>
    <div class="col-sm-8">
      <div class="card-body">
        <h3 class="mt-0 mb-2">
          <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
        </h3>
        {% if project.experience_role or project.experience_period %}
          <p class="experience-project-meta mb-2">
            {% if project.experience_role %}<strong>{{ project.experience_role }}</strong>{% endif %}
            {% if project.experience_role and project.experience_period %} · {% endif %}
            {% if project.experience_period %}{{ project.experience_period }}{% endif %}
          </p>
        {% endif %}
        <p class="mb-0">{{ project.description }}</p>
        <div class="experience-project-links">
          <a class="btn btn-sm z-depth-0" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">Details</a>
        </div>
      </div>
    </div>
  </div>
</article>
